FROM python:3.11-slim

WORKDIR /app

COPY requirements-frontend.txt .

RUN pip install --no-cache-dir \
    --timeout 300 \
    --retries 10 \
    numpy==1.26.4

RUN pip install --no-cache-dir \
    --timeout 300 \
    --retries 10 \
    -r requirements-frontend.txt

COPY . .

EXPOSE 8501

CMD ["streamlit", "run", "app/streamlit_app.py", "--server.address=0.0.0.0", "--server.port=8501"]
